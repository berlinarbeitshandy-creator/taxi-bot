# Schluessel zum Verschluesseln der Telethon-Sessions und API-Hashes.
# Leer lassen -> wird beim ersten Start unter data/.secret erzeugt.
PANEL_SECRET_KEY=

# Login fuer das Panel selbst (Basic-Auth). Leer lassen -> kein Login.
PANEL_USER=admin
PANEL_PASSWORD=

# Bind-Adresse
PANEL_HOST=127.0.0.1
PANEL_PORT=8000

# Faustregel fuer einen eingelaufenen Account. Je Account ueber den Regler
# im Panel einstellbar.
PANEL_ADD_QUOTA=40

# Womit ein frisch gebundener Account startet, bis er warm ist.
PANEL_WARMUP_QUOTA=10

# Grenzen des Reglers.
PANEL_QUOTA_MIN=5
PANEL_QUOTA_MAX=100

# Wie lange die Pause dauert, wenn sie nicht von Hand freigegeben wird.
PANEL_COOLDOWN_HOURS=10

# Vorgabe fuer die Pause zwischen zwei Aufnahmen in Sekunden.
PANEL_ADD_DELAY=45
